# ==== このファイルは「変数名の見本」です。実値は書かないでください ====
# ローカルでは `.env.local` に実値を入れます（.gitignore 済み）。
# 本番は Vercel Dashboard の Project → Settings → Environment Variables に設定します。
# （Vercel CLI で `vercel env pull .env.local` すると自動取得できます）

# --- Vercel Blob (Storage で Blob store を作成・接続すると自動発行) ---
# サムネイル画像と講座データ(JSON)の保存に使用。サーバー側のみで使用する。
BLOB_READ_WRITE_TOKEN=

# --- 管理者ゲート ---
# 講座の作成・編集・画像アップロードを保護するデモ用パスワード
ADMIN_PASSWORD=
