# ==== このファイルは「変数名の見本」です。実値は書かないでください ====
# ローカルでは `.env.local` に実値を入れます（.gitignore 済み）。
# 本番は Vercel Dashboard の Project → Settings → Environment Variables に設定します。

# --- Vercel Postgres (Storage で Postgres を作成すると自動発行) ---
# 講座データの永続化に使用
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel Blob (Storage で Blob を作成すると自動発行) ---
# サムネイル画像の保存に使用。サーバー側のみで使用し、クライアントへ露出しない
BLOB_READ_WRITE_TOKEN=

# --- 管理者ゲート ---
# 講座の作成・編集・画像アップロードを保護するデモ用パスワード
ADMIN_PASSWORD=
